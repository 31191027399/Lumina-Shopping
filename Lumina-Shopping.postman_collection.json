          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "try {",
                  "  var json = pm.response.json();",
                  "  var t = json.token || json.accessToken || (json.data && json.data.token);",
                  "  if (t) {",
                  "    pm.environment.set('token', t);",
                  "  }",
                  "} catch (e) {",
                  "  // Ignore token extraction errors; manual login can provide the token.",
                  "}"
                ]
              }
            }
          ]
        },
